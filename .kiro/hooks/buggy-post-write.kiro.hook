{
  "enabled": true,
  "name": "Buggy Post-Write Verification",
  "description": "After any code-writing tool completes (str_replace, fs_write, etc.), Buggy checks if the newly written code has potential issues by analyzing the affected functions for specification violations.",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Code was just written or modified. Check if the modified code introduces potential bugs: look for unchecked division, missing null guards, unbounded numeric operations, or non-deterministic behavior. If the buggy MCP server is available, use buggy_analyze on the affected file. Briefly report any concerns — don't auto-fix."
  }
}