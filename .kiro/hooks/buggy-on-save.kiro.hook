{
  "enabled": true,
  "name": "Buggy Triage on Save",
  "description": "When a Python file is saved, list its functions and flag the risky ones. Parsing only - no code is executed, so saving a file can never trigger a side effect.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A Python file was just saved. Call buggy_functions with the file path to list its functions and see which are investigable.\n\nThis tool only parses - it does not run the file. Do NOT call buggy_investigate, buggy_scan or buggy_repair here: those execute the module, which on a save hook would run import-time side effects on every keystroke-to-disk. If a function looks risky (division, indexing without a bounds check, unclamped arithmetic, money or percentage math), name it and offer to investigate it on request.\n\nKeep the response to a couple of lines. If nothing looks risky and the file parsed, say nothing."
  }
}
