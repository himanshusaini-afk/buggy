# The Tree-sitter grammar packages (tree-sitter-typescript, tree-sitter-python)
# declare optional peer ranges on `tree-sitter` that npm's strict resolver rejects
# when combined, even though the native ABI is compatible with the pinned
# tree-sitter@0.22.4. Accept the resolution so `npm install` (and git installs)
# work without manual flags.
legacy-peer-deps=true
