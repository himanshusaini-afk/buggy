# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Packaging and editable-install metadata
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Recorded findings (buggy investigate --record)
.buggy/

# Environment variables and secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE files
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Kiro local state (per-developer, not shared)
.kiro/cache/
.kiro/state/
.kiro/.meta.json

# Local MCP server config - holds machine-specific paths.
# Use mcp-config.example.json as the template.
.kiro/settings/

# SQLite temporary files
*.db-journal
*.db-wal
*.db-shm
